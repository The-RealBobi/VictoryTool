<Application
    x:Class="VictoryTool.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:VictoryTool.Desktop.Converters"
    RequestedThemeVariant="Dark">
  <Application.Resources>
    <converters:BooleanToOpacityConverter x:Key="BooleanToOpacity" />
    <SolidColorBrush x:Key="NightPitchBrush" Color="#07111F" />
    <SolidColorBrush x:Key="DockNavyBrush" Color="#0D1B2E" />
    <SolidColorBrush x:Key="RaisedBlueBrush" Color="#132846" />
    <SolidColorBrush x:Key="LightningBrush" Color="#4EA9C6" />
    <SolidColorBrush x:Key="ConfirmationBrush" Color="#D6A94E" />
    <SolidColorBrush x:Key="FrostTextBrush" Color="#F4F8FF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9FB3C8" />
    <SolidColorBrush x:Key="LowBorderBrush" Color="#263B55" />
    <SolidColorBrush x:Key="FaultBrush" Color="#FF7D88" />
    <SolidColorBrush x:Key="ReadyBrush" Color="#63CDA4" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource NightPitchBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FrostTextBrush}" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource DockNavyBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LowBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Control.fade-surface">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="ListBox.roster > ListBoxItem">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,9" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource LightningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NightPitchBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.confirm">
      <Setter Property="Background" Value="{DynamicResource ConfirmationBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource NightPitchBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RaisedBlueBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource FrostTextBrush}" />
    </Style>

    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource RaisedBlueBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource FrostTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LightningBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>

    <Style Selector="TextBox, ComboBox">
      <Setter Property="Background" Value="{DynamicResource DockNavyBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LowBorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style Selector="ListBox.roster">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox.roster > ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="ListBox.roster > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RaisedBlueBrush}" />
    </Style>
  </Application.Styles>
</Application>

<Window
    x:Class="VictoryTool.Desktop.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
    xmlns:vm="using:VictoryTool.Desktop.ViewModels"
    xmlns:views="using:VictoryTool.Desktop.Views"
    Title="VictoryTool"
    Icon="avares://VictoryTool.Desktop/Assets/AppIcon.png"
    Width="1280"
    Height="800"
    MinWidth="900"
    MinHeight="620">
  <Grid RowDefinitions="76,*,48">
    <Grid x:Name="MainInteraction" Grid.RowSpan="3" RowDefinitions="76,*,48" IsEnabled="{Binding CanInteract}">
    <Border Background="{DynamicResource DockNavyBrush}" BorderBrush="{DynamicResource LowBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Text="VICTORY TOOL" />
        <ComboBox Grid.Column="1" Width="180" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguageChoice}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24">
      <Grid>
        <Border Classes="panel fade-surface" x:Name="OnboardingScreen" IsVisible="{Binding IsOnboardingVisible}" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock Classes="page-title" Text="{Binding Text.WelcomeTitle}" />
            <TextBlock Classes="muted" Text="{Binding Text.WelcomeBody}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding GameDumpInput}" PlaceholderText="{Binding Text.DumpPath}" />
              <Button Grid.Column="1" Click="SelectDumpFolder" Content="{Binding WizardText.Browse}" />
              <Button x:Name="LoadDumpButton" Grid.Column="2" Classes="primary" Command="{Binding LoadGameDumpCommand}" Content="{Binding Text.LoadDump}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsIndexing}" />
            <TextBlock Classes="muted" Text="{Binding IndexProgressMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="panel fade-surface" x:Name="MainMenuScreen" IsVisible="{Binding IsMainMenuVisible}" Width="760" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
          <StackPanel Spacing="22">
            <TextBlock Classes="page-title" Text="{Binding WizardText.WhatWouldYouLike}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Button x:Name="CreateCharacterButton" Command="{Binding BeginCreateCommand}" Content="{Binding CreateCharacterActionLabel}" />
              <Button Grid.Column="1" Click="SelectModificationPackage" Content="{Binding WizardText.ModifyNewCharacter}" />
              <Button Grid.Column="2" Command="{Binding BeginIncorporationCommand}" Content="{Binding WizardText.ImportIntoVictoryRoad}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel fade-surface" x:Name="IncorporationScreen" IsVisible="{Binding IsIncorporationVisible}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="32" DragDrop.AllowDrop="True" DragDrop.DragOver="BatchDragOver" DragDrop.Drop="BatchDrop">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
            <TextBlock Classes="page-title" Text="{Binding WizardText.IncorporationTitle}" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
              <Button x:Name="AddPackageButton" Click="SelectBatchPackage" Classes="primary" Content="{Binding WizardText.AddPackage}" />
              <Button Grid.Column="2" x:Name="RefreshPackagesButton" Command="{Binding RefreshBatchPreviewsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="18" Height="18" Data="M12,20q-3.35,0-5.68-2.32T4,12T6.33,6.32T12,4q1.73,0 3.3,0.71Q16.88,5.43 18,6.75V4h2v7H13V9h4.2q-0.8-1.4-2.19-2.2T12,6Q9.5,6 7.75,7.75T6,12t1.75,4.25T12,18q1.93,0 3.48-1.1T17.65,14h2.1q-0.7,2.65-2.85,4.32T12,20Z" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding RefreshBatchPreviewsLabel}" />
                </StackPanel>
              </Button>
            </Grid>
            <ListBox Grid.Row="2" ItemsSource="{Binding BatchRows}" SelectedItem="{Binding SelectedBatchRow}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BatchPackageRow">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="8">
                    <Image Width="48" Height="48" Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding PackagePath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PackagePath}" />
                      <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="RemoveBatchPackage" Content="{Binding $parent[ListBox].DataContext.WizardText.Remove}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
              <CheckBox x:Name="GenerateAnimationsToggle"
                        Content="{Binding WizardText.GenerateAnimations}"
                        IsChecked="{Binding GenerateAnimationsEnabled}" />
              <Button x:Name="AnimationTypesButton" AutomationProperties.Name="{Binding AnimationTypesLabel}"
                      IsVisible="{Binding GenerateAnimationsEnabled}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock VerticalAlignment="Center" Text="{Binding AnimationTypesLabel}" />
                  <PathIcon Width="16" Height="16" Data="M12,15.4l-6-6L7.4,8L12,12.6L16.6,8L18,9.4l-6,6Z" />
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel Spacing="8" MinWidth="160">
                      <CheckBox x:Name="GenerateBothAnimationsCheckBox" Content="{Binding BothAnimationsLabel}"
                                IsChecked="{Binding GenerateBothAnimations}" />
                      <CheckBox x:Name="GenerateChrAnimationsCheckBox" Content="CHR"
                                IsChecked="{Binding GenerateChrAnimations}" />
                      <CheckBox x:Name="GenerateEventAnimationsCheckBox" Content="EVENT"
                                IsChecked="{Binding GenerateEventAnimations}" />
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

          </Grid>
        </Border>

        <views:CharactersWorkspaceView Classes="fade-surface" x:Name="CharacterScreen" IsVisible="{Binding IsCharacterStep}" />

        <Border Classes="panel fade-surface" x:Name="DetailsScreen" IsVisible="{Binding IsDetailsStep}" Width="720" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <TextBlock Classes="page-title" Text="{Binding WizardText.CharacterName}" />
            <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
              <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding WizardText.GameLanguage}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding LocalizationEditorRows}" SelectedItem="{Binding SelectedLocalizationEditorRow}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Command="{Binding OpenLocalesJsonCommand}" Content="{Binding WizardText.EditLocalesJson}" />
              <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding LocalesJsonPath}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Classes="section-title" Text="{Binding WizardText.WesternName}" />
            <TextBox Text="{Binding SelectedLocalizationEditorRow.LocalizedName}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="muted" Text="{Binding WizardText.ShortName}" />
                <TextBox Text="{Binding SelectedLocalizationEditorRow.ShortName}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="muted" Text="{Binding WizardText.ShirtName}" />
                <TextBox Text="{Binding SelectedLocalizationEditorRow.UpperName}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="section-title" Text="{Binding WizardText.JapaneseName}" />
            <TextBox Text="{Binding SelectedLocalizationEditorRow.JapaneseName}" />
            <TextBlock Classes="muted" Text="{Binding WizardText.Description}" />
            <TextBox MinHeight="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Text="{Binding SelectedLocalizationEditorRow.Description}" />
          </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Classes="panel fade-surface" x:Name="AttributesScreen" IsVisible="{Binding IsAttributesStep}" Width="760" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="12">
            <TextBlock Classes="page-title" Text="{Binding WizardText.CharacterAttributes}" />
            <Grid ColumnDefinitions="210,*" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Text="{Binding WizardText.Gender}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding IdentityGenderChoices}" SelectedItem="{Binding ActiveDraftGenderChoice}" />
            </Grid>
            <Grid ColumnDefinitions="210,*" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Text="{Binding WizardText.OriginGame}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding IdentityOriginGameChoices}" SelectedItem="{Binding ActiveDraftOriginGameChoice}" />
            </Grid>
            <Grid ColumnDefinitions="210,*" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Text="{Binding WizardText.AcademicYear}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding IdentityAcademicYearChoices}" SelectedItem="{Binding ActiveDraftAcademicYearChoice}" />
            </Grid>
            <Grid ColumnDefinitions="210,*" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Text="{Binding WizardText.TeamAssociation}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding TeamAssociationOptions}" SelectedItem="{Binding ActiveDraftTeamAssociationChoice}" />
            </Grid>
            <Grid ColumnDefinitions="210,*" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Text="{Binding WizardText.Affinity}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding AffinityChoices}" SelectedItem="{Binding ActiveDraftAffinityChoice}" />
            </Grid>
            <Grid ColumnDefinitions="210,*" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Text="{Binding WizardText.MainPosition}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding PositionChoices}" SelectedItem="{Binding ActiveDraftMainPositionChoice}" />
            </Grid>
            <Grid ColumnDefinitions="210,*" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Text="{Binding WizardText.SecondaryPosition}" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding PositionChoices}" SelectedItem="{Binding ActiveDraftSubPositionChoice}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel fade-surface" x:Name="SkillsScreen" IsVisible="{Binding IsSkillsStep}" MaxWidth="900" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <TextBlock Classes="page-title" Text="{Binding WizardText.CharacterSkills}" />
            <StackPanel x:Name="MainSkillsGroup" Spacing="6">
              <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="14" Margin="0,0,0,8">
                <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding WizardText.TechniqueVariant}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TechniqueVariantChoices}" SelectedItem="{Binding SelectedTechniqueVariantChoice}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding ApplyTechniqueTemplateCommand}" Content="{Binding WizardText.ApplyTechniqueTemplate}" />
              </Grid>
              <TextBlock Classes="section-title" Text="{Binding WizardText.MainSkills}" />
              <ItemsControl ItemsSource="{Binding MainSkillEditorRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CharacterSkillEditorRow">
                    <Grid ColumnDefinitions="*,180" ColumnSpacing="14" Margin="0,0,0,6">
                      <ComboBox ItemsSource="{Binding SkillChoices}" SelectedItem="{Binding SelectedSkill}" />
                      <NumericUpDown Grid.Column="1" Minimum="1" Maximum="99" Value="{Binding UnlockLevelValue}" PlaceholderText="{Binding UnlockLevelLabel}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel x:Name="AlternateSkillsGroup" Spacing="6">
              <TextBlock Classes="section-title" Text="{Binding WizardText.AlternateSkills}" />
              <ItemsControl ItemsSource="{Binding AlternateSkillEditorRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CharacterSkillEditorRow">
                    <Grid ColumnDefinitions="*,180" ColumnSpacing="14" Margin="0,0,0,6">
                      <ComboBox ItemsSource="{Binding SkillChoices}" SelectedItem="{Binding SelectedSkill}" />
                      <NumericUpDown Grid.Column="1" Minimum="1" Maximum="99" Value="{Binding UnlockLevelValue}" PlaceholderText="{Binding UnlockLevelLabel}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
        </Border>

        <Border Classes="panel fade-surface" x:Name="AppearanceScreen" IsVisible="{Binding IsAppearanceStep}" Width="820" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid ColumnDefinitions="*,300" ColumnSpacing="28">
            <StackPanel Spacing="16">
              <TextBlock Classes="page-title" Text="{Binding WizardText.CharacterAppearance}" />
              <StackPanel Spacing="5">
                <TextBlock Classes="muted" Text="{Binding WizardText.NormalFace}" />
                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="8">
                  <Border Width="64" Height="64" Background="{DynamicResource RaisedBlueBrush}" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                      <Image x:Name="StandardPortraitThumbnail" Source="{Binding StandardPortraitPreview}" Stretch="Uniform" />
                      <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom" IsVisible="{Binding IsStandardPortraitPreviewLoading}" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBox Text="{Binding ActiveDraftStandardPortraitDisplayPath, Mode=OneWay}" IsReadOnly="True" />
                    <TextBlock Classes="muted" Text="{Binding StandardPortraitPreviewStatus}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="2" VerticalAlignment="Top" Click="SelectStandardPortrait" Content="{Binding WizardText.SelectFile}" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Classes="muted" Text="{Binding WizardText.FaceWithoutRearHair}" />
                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="8">
                  <Border Width="64" Height="64" Background="{DynamicResource RaisedBlueBrush}" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                      <Image x:Name="UniformPortraitThumbnail" Source="{Binding UniformPortraitPreview}" Stretch="Uniform" />
                      <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Bottom" IsVisible="{Binding IsUniformPortraitPreviewLoading}" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBox Text="{Binding ActiveDraftUniformPortraitDisplayPath, Mode=OneWay}" IsReadOnly="True" />
                    <TextBlock Classes="muted" Text="{Binding UniformPortraitPreviewStatus}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="2" VerticalAlignment="Top" Click="SelectUniformPortrait" Content="{Binding WizardText.SelectFile}" />
                </Grid>
              </StackPanel>
              <TextBlock Classes="muted" Text="{Binding SaveBlockingReason}" TextWrapping="Wrap" />
              <Button x:Name="ReloadPortraitPreviewsButton" HorizontalAlignment="Left" Command="{Binding ReloadPortraitPreviewsCommand}" Content="{Binding ReloadPortraitPreviewsLabel}" />
              <StackPanel Spacing="5">
                <TextBlock Classes="muted" Text="{Binding WizardText.Model3D}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding ActiveDraftHeadModelDisplayPath, Mode=OneWay}" IsReadOnly="True" />
                  <Button Grid.Column="1" Click="SelectHeadModel" Content="{Binding WizardText.SelectFile}" />
                </Grid>
              </StackPanel>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <StackPanel Spacing="3">
                  <TextBlock Classes="muted" Text="{Binding WizardText.Uniform}" />
                  <ComboBox x:Name="UniformChoice" ItemsSource="{Binding AppearanceUniformOptions}" SelectedItem="{Binding ActiveDraftUniformChoice}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="{Binding WizardText.SelectFile}"
                          IsVisible="{Binding CanSelectCustomUniform}"
                          Click="SelectUniformModel" />
                  <TextBlock Classes="muted"
                             Text="{Binding ActiveDraftUniformModelDisplayPath}"
                             ToolTip.Tip="{Binding ActiveDraftUniformModelPath}"
                             IsVisible="{Binding CanSelectCustomUniform}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="muted" Text="{Binding WizardText.Shoes}" />
                  <ComboBox x:Name="ShoesChoice" ItemsSource="{Binding AppearanceShoesOptions}" SelectedItem="{Binding ActiveDraftShoesChoice}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button x:Name="SelectCustomShoes" Content="{Binding WizardText.SelectFile}"
                          IsVisible="{Binding CanSelectCustomShoes}"
                          Click="SelectShoesModel" />
                  <TextBlock Classes="muted"
                             Text="{Binding ActiveDraftShoesModelDisplayPath}"
                             IsVisible="{Binding CanSelectCustomShoes}"
                             ToolTip.Tip="{Binding ActiveDraftShoesModelPath}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Classes="muted" Text="{Binding WizardText.Gloves}" />
                  <ComboBox ItemsSource="{Binding AppearanceGloveOptions}" SelectedItem="{Binding ActiveDraftGloveChoice}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <StackPanel Spacing="3">
                  <TextBlock Classes="muted" Text="{Binding WizardText.ForceUniform}" />
                  <CheckBox IsChecked="{Binding ActiveDraftForceKit}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="muted" Text="{Binding WizardText.ChestSize}" />
                  <ComboBox ItemsSource="{Binding ChestSizeOptions}" SelectedItem="{Binding ActiveDraftChestSize}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Classes="muted" Text="{Binding WizardText.OpenCollar}" />
                  <CheckBox IsChecked="{Binding ActiveDraftUniformCollarOpen}" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="3">
                <TextBlock Classes="muted" Text="{Binding WizardText.BodyType}" />
                <ComboBox ItemsSource="{Binding BodyTypeChoices}" SelectedItem="{Binding ActiveDraftBodyTypeChoice}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="5">
                <TextBlock Classes="muted" Text="{Binding WizardText.SkinColor}" />
                <Grid ColumnDefinitions="180,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding ActiveDraftSkinColor}" PlaceholderText="#RRGGBB" />
                  <Button Grid.Column="1" ToolTip.Tip="{Binding WizardText.SkinColor}" Click="BeginScreenColorPick">
                    <Image Width="20" Height="20" Source="avares://VictoryTool.Desktop/Assets/Ui/dropper_eye.png" />
                    <Button.Flyout>
                      <Flyout Placement="Bottom" Opened="SkinColorPickerOpened">
                        <cp:ColorView x:Name="SkinColorPicker"
                                      Width="360"
                                      Margin="4"
                                      IsAlphaEnabled="False"
                                      IsAlphaVisible="False"
                                      IsAccentColorsVisible="False"
                                      IsColorPaletteVisible="False"
                                      IsColorComponentsVisible="False"
                                      IsColorModelVisible="False"
                                      ColorChanged="SkinColorChanged" />
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <Border Height="260" Background="{DynamicResource RaisedBlueBrush}" CornerRadius="8" ClipToBounds="True">
                <Grid>
                  <Grid IsVisible="{Binding HasLayeredAppearance}">
                    <Image Source="{Binding AppearanceBackPortrait}" Stretch="Uniform" />
                    <Image Source="{Binding PlayerCardUniform}"
                           Stretch="Uniform" />
                    <Image Source="{Binding AppearanceFrontPortrait}" Stretch="Uniform" />
                  </Grid>
                  <Image IsVisible="{Binding ShowAppearancePortrait}" Source="{Binding AppearancePortrait}" Stretch="Uniform" />
                </Grid>
              </Border>
              <TextBlock FontWeight="SemiBold" Text="{Binding ReviewDisplayName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>

        <Border Classes="panel fade-surface" x:Name="AcquisitionScreen" IsVisible="{Binding IsAcquisitionStep}" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
            <TextBlock Classes="page-title" Text="{Binding WizardText.Acquisition}" />
            <TextBlock Classes="muted" Text="{Binding WizardText.DeliveryDefault}" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding AcquisitionModes}" SelectedItem="{Binding AcquisitionMode}" />
            <TextBlock Classes="muted" Text="{Binding WizardText.DeliveryIdsAutomatic}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="panel fade-surface" x:Name="ReviewScreen" IsVisible="{Binding IsReviewStep}" Width="820" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
            <TextBlock Classes="page-title" Text="{Binding WizardText.ConfirmCharacter}" />
            <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="28">
              <Border Background="#050D1C" BorderBrush="{DynamicResource LowBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                  <TextBlock Classes="section-title" Text="{Binding WizardText.TechniqueList}" />
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MainSkillEditorRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CharacterSkillEditorRow">
                          <TextBlock Margin="0,0,0,9" Text="{Binding SelectedSkill.Name}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Spacing="8">
                <Border Height="270" Background="{DynamicResource RaisedBlueBrush}" CornerRadius="8" ClipToBounds="True">
                  <Grid>
                    <Grid IsVisible="{Binding HasLayeredAppearance}">
                      <Image Source="{Binding AppearanceBackPortrait}" Stretch="Uniform" />
                      <Image Source="{Binding PlayerCardUniform}"
                             Stretch="Uniform" />
                      <Image Source="{Binding AppearanceFrontPortrait}" Stretch="Uniform" />
                    </Grid>
                    <Image IsVisible="{Binding ShowAppearancePortrait}" Source="{Binding AppearancePortrait}" Stretch="Uniform" />
                  </Grid>
                </Border>
                <views:RubyTextView FontSize="20" FontWeight="SemiBold" DataContext="{Binding ReviewDisplayNameDocument}" />
                <TextBlock Classes="muted" Text="{Binding ReviewSeries}" IsVisible="{Binding HasReviewSeries}" TextTrimming="CharacterEllipsis" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="muted" Text="{Binding WizardText.Affinity}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding ReviewAffinity}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="muted" Text="{Binding WizardText.Position}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding ReviewMainPosition}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                    <TextBlock Classes="muted" Text="{Binding WizardText.OriginGame}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding ReviewOriginGame}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="3" Spacing="8">
              <TextBlock x:Name="SaveBlockingReasonText" Classes="muted" Text="{Binding SaveBlockingReason}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding LastSavedPackagePath}" TextWrapping="Wrap" />
              <Button x:Name="SaveCharacterButton" Classes="primary" HorizontalAlignment="Right" Click="SaveCharacterPackage" IsEnabled="{Binding CanSaveDraft}" Content="{Binding WizardText.SaveCharacter}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource DockNavyBrush}" BorderBrush="{DynamicResource LowBorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><TextBlock VerticalAlignment="Center" Text="{Binding ErrorStatusMessage}" /><Button Grid.Column="1" Command="{Binding OpenLogCommand}" Content="{Binding LogButtonLabel}" /><Button x:Name="WorkflowBackButton" Grid.Column="2" Command="{Binding PreviousWizardStepCommand}" Content="{Binding WizardText.Back}" IsEnabled="{Binding CanGoBack}" IsVisible="{Binding ShowWorkflowNavigation}" /><Button x:Name="WorkflowForwardButton" Grid.Column="3" Classes="primary" Click="AdvanceWorkflow" Content="{Binding ForwardActionLabel}" IsEnabled="{Binding CanAdvanceWorkflow}" IsVisible="{Binding ShowWorkflowNavigation}" /></Grid>
    </Border>

    </Grid>

    <Border Classes="fade-surface" x:Name="PostSavePrompt" Grid.RowSpan="3" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding IsPostSavePromptVisible}" Background="#E60A1428" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10">
      <StackPanel Spacing="16" Width="520">
        <TextBlock Text="{Binding LastSavedPackagePath}" TextWrapping="Wrap" />
        <TextBlock Classes="page-title" Text="{Binding WizardText.SaveToBatchQuestion}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button Command="{Binding ReturnToMainMenuCommand}" Content="{Binding WizardText.SaveToBatchNo}" />
          <Button Command="{Binding ConfirmAddSavedPackageCommand}" Classes="primary" Content="{Binding WizardText.SaveToBatchYes}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="UnsavedChangesPrompt" Grid.RowSpan="3" IsEnabled="{Binding !IsBusy}" Background="#B807111F" IsVisible="{Binding IsUnsavedChangesPromptVisible}">
      <Border Classes="panel" Width="580" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Classes="section-title" Text="{Binding UnsavedChangesMessage}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding SaveBlockingReason}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="CancelNavigationButton" Command="{Binding CancelPendingNavigationCommand}" Content="{Binding CancelNavigationLabel}" />
            <Button x:Name="DiscardChangesButton" Command="{Binding DiscardPendingChangesCommand}" Content="{Binding DiscardChangesLabel}" />
            <Button x:Name="SavePendingChangesButton" Classes="primary" Click="SaveCharacterPackage" IsEnabled="{Binding CanSaveDraft}" Content="{Binding WizardText.SaveCharacter}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="RecoveryCloseFailurePrompt" Grid.RowSpan="3" IsVisible="{Binding IsRecoveryCloseFailureVisible}" IsEnabled="{Binding !IsBusy}" Background="#B807111F">
      <Border Classes="panel" Width="620" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding RecoveryCloseFailureMessage}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding ErrorStatusMessage}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelRecoveryCloseButton" Command="{Binding CancelRecoveryCloseCommand}" Content="{Binding CancelNavigationLabel}" />
            <Button Command="{Binding CloseWithoutRecoveryCommand}" Content="{Binding CloseWithoutRecoveryLabel}" />
            <Button Command="{Binding RetryRecoveryCloseCommand}" Content="{Binding RetryRecoveryCloseLabel}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="3" Background="#B807111F" x:Name="BusyOverlay" Focusable="True" IsVisible="{Binding IsBusy}">
      <Border Classes="panel" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="16">
          <ProgressBar IsIndeterminate="True" Height="8" />
          <TextBlock Classes="muted" Text="{Binding BusyMessage}" TextWrapping="Wrap" MaxHeight="90" />
          <Button x:Name="CancelExportButton" IsVisible="{Binding CanCancelOperation}" HorizontalAlignment="Right" Click="CancelExport" Content="{Binding CancelExportLabel}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VictoryTool.Desktop.ViewModels"
    x:Class="VictoryTool.Desktop.Views.RubyTextView"
    x:DataType="vm:RubyTextDocumentViewModel">
  <ItemsControl ItemsSource="{Binding Lines}" AutomationProperties.Name="{Binding AccessibleText}">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:RubyTextLine">
        <ItemsControl MinHeight="18" ItemsSource="{Binding VisualSegments}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RubyTextSegment">
              <Grid RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" FontSize="9" FontWeight="Normal" HorizontalAlignment="Center"
                    Text="{Binding Reading}" Height="{Binding ReadingHeight}" />
                <TextBlock Grid.Row="1" Text="{Binding Text}" VerticalAlignment="Bottom" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
